# Smart Contract Address (Deployed on Ethereum Sepolia)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xd1156FdEec51bffBb897596fd97B1877ffB2aE61

# Target Chain ID (11155111 for Sepolia, 31337 for Hardhat)
NEXT_PUBLIC_CHAIN_ID=11155111

# Public Sepolia RPC URL
NEXT_PUBLIC_RPC_URL=https://gateway.tenderly.co/public/sepolia

# Pinata IPFS Credentials (Get from https://app.pinata.cloud/developers/api-keys)
PINATA_JWT=your_pinata_jwt_token_here

# Public IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://teal-causal-tortoise-675.mypinata.cloud/ipfs

# Backend Signer Private Key (Required outside local development)
PRIVATE_KEY=your_ethereum_private_key_without_0x

# Mandatory Security Secrets (Must be set from environment with no defaults)
JWT_SECRET=your_super_strong_cryptographic_jwt_secret_minimum_32_bytes
RELAY_SECRET_KEY=your_secure_relay_shared_secret_key
# Dedicated secret key for candidate OTP HMAC-SHA256 generation (min 32 bytes)
OTP_SECRET=your_cryptographic_otp_hmac_secret_key_minimum_32_bytes

# PostgreSQL Database URL (Neon / Supabase / Vercel Postgres with Prisma)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Dedicated Test Database URL (Required for running tests against a real database; tests refuse to run against DATABASE_URL)
DATABASE_URL_TEST="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb_test?sslmode=require"

# Student OTP Email Service (Resend API in Production, or Dev Simulation)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="VeriChain Security <auth@verichain.network>"
