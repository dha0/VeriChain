# Smart Contract Address (Deploy on Sepolia or Remix VM / Hardhat)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Target Chain ID (11155111 for Sepolia, 31337 for Hardhat)
NEXT_PUBLIC_CHAIN_ID=11155111

# Pinata IPFS Credentials (Get from https://app.pinata.cloud/developers/api-keys)
# Safe on server side only (API route)
PINATA_JWT=your_pinata_jwt_token_here
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here

# Public IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
